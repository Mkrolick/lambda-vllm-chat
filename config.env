# Defaults for llmchat. Override any value in ~/.config/lambda-llm-chat/config.env, or set it as an
# environment variable for one run (LLMCHAT_MODEL_REPO=... llmchat up). One KEY=value per line, no inline comments.

# Hugging Face model to serve. MODEL_REVISION can be a branch, tag or commit sha; pin a sha for reproducible evals.
MODEL_REPO=huihui-ai/Huihui-Qwen3.8-27B-abliterated
MODEL_REVISION=main
# Name the API and UI show for the model. Empty = lowercased repo name.
SERVED_NAME=

# vLLM. VLLM_ARGS are appended to `vllm serve`; the parsers below match Qwen3.5/3.8 chat templates.
# MAX_NUM_SEQS caps concurrent requests: hybrid linear-attention models like Qwen3.8 have one cache block per sequence
# (~370 fit on an 80 GB GPU), and vLLM's default of 1024 makes startup fail.
VLLM_VERSION=0.34.0
MAX_MODEL_LEN=131072
MAX_NUM_SEQS=128
GPU_MEMORY_UTILIZATION=0.92
VLLM_ARGS=--enable-prefix-caching --reasoning-parser qwen3 --enable-auto-tool-choice --tool-call-parser qwen3_coder

# GPU choice: the cheapest x86 Lambda type with capacity that has at least MIN_VRAM_GB of total GPU memory on at most
# MAX_GPUS GPUs (tensor parallel = GPU count). INSTANCE_TYPES restricts the choice to a comma-separated list, in order of
# preference (e.g. gpu_1x_h100_pcie,gpu_1x_h100_sxm5).
MIN_VRAM_GB=80
MAX_GPUS=2
INSTANCE_TYPES=

# The box terminates itself after this many minutes with no requests to the model (0 = never).
IDLE_MIN=120

# Local ports for the SSH tunnel (OpenAI-compatible API) and the local Open WebUI.
API_PORT=18000
UI_PORT=13000

# Where transcripts and Open WebUI data are kept on this machine.
DATA_DIR=~/LLM-Chat
